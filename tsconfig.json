{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "baseUrl": "./",
    "paths": {
      "@modules/*": ["src/modules/*"],
      "@core-navigations/*": ["src/core-navigations/*"],
      "@assets/*": ["./assets/*"],
      "@core-components/*":["src/core-components/*"],  
      "@core-services/*": ["/src/core-services/*"],
    }
  }
}
